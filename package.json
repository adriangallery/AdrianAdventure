{
  "name": "adrian-adventure",
  "version": "0.1.0",
  "type": "module",
  "description": "Point-and-click adventure game with Web3 integration on Base",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "trailer": "vite --open '/?trailer'",
    "trailer:record": "vite --open '/?trailer&record'",
    "trailer:capture": "node scripts/capture-trailer.cjs",
    "build": "tsc && vite build && cp -r assets dist/",
    "preview": "vite preview",
    "build:android": "npm run build && find dist/assets/scenes -name 'background.png' -delete && find dist/assets/scenes -name 'foreground.png' -delete && npx cap sync android",
    "open:android": "npx cap open android",
    "build:steam": "npm run build && electron-builder --dir",
    "dev:steam": "npm run build && electron ."
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@walletconnect/ethereum-provider": "^2.23.9",
    "phaser": "^3.80.0",
    "qrcode": "^1.5.4",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@types/qrcode": "^1.5.6",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "puppeteer": "^24.41.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.zeroadventures.zeroadventure2",
    "productName": "ZEROadventure II",
    "directories": {
      "output": "steam-build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*.cjs",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": "dir"
    },
    "mac": {
      "target": "dir"
    },
    "linux": {
      "target": "dir"
    }
  },
  "overrides": {
    "@reown/appkit": "1.8.19",
    "@reown/appkit-common": "1.8.19",
    "@reown/appkit-controllers": "1.8.19",
    "@reown/appkit-pay": "1.8.19",
    "@reown/appkit-polyfills": "1.8.19",
    "@reown/appkit-scaffold-ui": "1.8.19",
    "@reown/appkit-ui": "1.8.19",
    "@reown/appkit-utils": "1.8.19",
    "@reown/appkit-wallet": "1.8.19"
  }
}

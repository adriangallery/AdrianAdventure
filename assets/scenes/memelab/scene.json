  "conditionalOverlays": [],
  "screens": {
    "virus_screen": {"bounds": {"x": 23.8, "y": 46.4, "w": 4.6, "h": 12.0}, "color": "green", "label": "MEMELAB // VIRUS MONITOR"}
  },
  "regions": {
    "hotspots": [
      {
        "id": "hs_meme_tube",
        "useResponses": {
          "pepememe": [
            "I hold Pepe up to his old tube. He doesn't want to go back. Neither would I."
          ]
        },
        "name": "Containment Tube",
        "bounds": {
          "x": 44.1,
          "y": 19,
          "w": 11.9,
          "h": 69
        },
        "scripts": {
          "LOOK": [
            {
              "op": "ifFlag",
              "flag": "memelab_clear_vision",
              "then": [
                {
                  "op": "say",
                  "text": "A giant tube of swirling green goo. Label: 'CONCENTRATED MEME ENERGY — DO NOT RELEASE'. It looks like it wants to be released."
                }
              ],
              "else": [
                {
                  "op": "say",
                  "text": "Through the anaglyph distortion I can barely make out... a giant tube? Something green pulses inside. My eyes hurt just looking at it."
                }
              ]
            }
          ],
          "USE": [
            {
              "op": "ifFlag",
              "flag": "memelab_clear_vision",
              "then": [
                {
                  "op": "say",
                  "text": "I touch the glass. The goo swirls faster. A readout: 'VIRALITY: CRITICAL'. I take my hand back. Slowly."
                }
              ],
              "else": [
                {
                  "op": "say",
                  "text": "I reach toward the blurry shape. If only I could see clearly through this optical nightmare..."
                }
              ]
            }
          ],
          "TALK": [
            {
              "op": "say",
              "text": "I press my ear to the tube. Tiny voices whisper: '...gm... gm... gm...' Polite. Terrifying, but polite."
            }
          ],
          "PICK": [
            {
              "op": "say",
              "text": "Bolted to the floor and the ceiling. Somebody really didn't want this to go for a walk."
            }
          ],
          "PUSH": [
            {
              "op": "say",
              "text": "I push the tube. The goo sloshes and glares at me. Goo can glare. I've learned that today."
            }
          ]
        }
      },
      {
        "id": "hs_meme_virus_screen",
        "name": "Meme Virus Monitor",
        "bounds": {
          "x": 21.4,
          "y": 43.8,
          "w": 8.1,
          "h": 20.1
        },
        "scripts": {
          "LOOK": [
            {
              "op": "ifFlag",
              "flag": "memelab_clear_vision",
              "then": [
                {
                  "op": "say",
                  "screen": "virus_screen",
                  "text": "'MEME VIRUS 99%. DEPLOYMENT: PENDING.' Somebody built a weapon out of jokes. And left it at ninety-nine."
                },
                {
                  "op": "say",
                  "screen": "virus_screen",
                  "text": "The log: 'PROPAGATION: EXPONENTIAL. TARGET: ALL TIMELINES.' Somebody here had very big plans and very small fonts."
                }
              ],
              "else": [
                {
                  "op": "say",
                  "text": "I squint through the red-blue haze. Numbers flicker on a screen... 99%... something. Can't read the rest."
                }
              ]
            }
          ],
          "USE": [
            {
              "op": "ifFlag",
              "flag": "memelab_clear_vision",
              "then": [
                {
                  "op": "say",
                  "screen": "virus_screen",
                  "text": "I try the keyboard. Dead. But the screen flickers: 'LAST OPERATOR: Dr. S. — EXPERIMENT STATUS: CONTAINED'. Dr. Satoshi was running this lab."
                }
              ],
              "else": [
                {
                  "op": "say",
                  "text": "I mash keys I can barely see. The screen responds with garbled colors. Useless without clear vision."
                }
              ]
            }
          ],
          "TALK": [
            {
              "op": "say",
              "text": "'What are you deploying?' The progress bar stays at 99%. It's keeping that last percent for itself."
            }
          ]
        }
      },
      {
        "id": "hs_rarity_index",
        "name": "Rarity Index Board",
        "bounds": {
          "x": 63.1,
          "y": 26.3,
          "w": 16.9,
          "h": 31.7
        },
        "scripts": {
          "LOOK": [
            {
              "op": "ifFlag",
              "flag": "memelab_clear_vision",
              "then": [
                {
                  "op": "say",
                  "text": "A board labelled 'RARITY INDEX': little faces ranked by rarity. A periodic table for people who never went outside."
                },
                {
                  "op": "say",
                  "text": "Common, Rare, Epic, Legendary... and circled in red at the top: 'ULTRA RARE PEPE'. Circled three times. Somebody cared."
                }
              ],
              "else": [
                {
                  "op": "say",
                  "text": "A board with... charts? Faces? Everything is doubled and shifted. The anaglyph makes it impossible to read."
                }
              ]
            }
          ],
          "USE": [
            {
              "op": "say",
              "text": "Each tier has a price next to it. Somebody priced frogs. I'm not judging. I'm a bit judging."
            }
          ],
          "PICK": [
            {
              "op": "say",
              "text": "Screwed to the wall. This kind of research should never leave the room. Possibly not even the wall."
            }
          ]
        }
      },
      {
        "id": "hs_chemicals",
        "name": "Chemical Station",
        "bounds": {
          "x": 32.2,
          "y": 34.4,
          "w": 8.1,
          "h": 51.3
        },
        "scripts": {
          "LOOK": [
            {
              "op": "ifFlag",
              "flag": "memelab_clear_vision",
              "then": [
                {
                  "op": "say",
                  "text": "Glowing beakers labelled 'DISTILLED SARCASM', 'PURE IRONY' and 'DECAF'. Decaf is the scary one."
                }
              ],
              "else": [
                {
                  "op": "say",
                  "text": "Blurry glass shapes. Something green. Could be chemistry equipment, could be modern art. Hard to tell in anaglyph."
                }
              ]
            }
          ],
          "USE": [
            {
              "op": "say",
              "text": "I'm not drinking that. I'm sarcastic enough. Ask anyone. Ask DOORIS."
            }
          ],
          "PICK": [
            {
              "op": "say",
              "text": "These stay on the shelf. I've had enough mystery liquids for one case."
            }
          ],
          "OPEN": [
            {
              "op": "say",
              "text": "I uncork a beaker. It smells like a joke I didn't get. I cork it back, fast."
            }
          ]
        }
      },
      {
        "id": "hs_do_not_push",
        "name": "DO NOT PUSH Button",
        "bounds": {
          "x": 89.3,
          "y": 34.3,
          "w": 8,
          "h": 43.6
        },
        "scripts": {
          "LOOK": [
            {
              "op": "ifFlag",
              "flag": "memelab_clear_vision",
              "then": [
                {
                  "op": "say",
                  "text": "A big red button. 'DO NOT PUSH', in six languages. Every one of them is lying to me."
                }
              ],
              "else": [
                {
                  "op": "say",
                  "text": "Something red. A button? The label is unreadable through the distortion but I can feel it daring me."
                }
              ]
            }
          ],
          "USE": [
            {
              "op": "ifFlag",
              "flag": "pushed_button",
              "then": [
                {
                  "op": "say",
                  "text": "I already pushed it. The tube is still glowing. Lesson learned. Mostly."
                }
              ],
              "else": [
                {
                  "op": "setFlag",
                  "flag": "pushed_button",
                  "value": true
                },
                {
                  "op": "playSound",
                  "key": "keypad_beep"
                },
                {
                  "op": "say",
                  "screen": "virus_screen",
                  "text": "I push the button. The containment tube surges with light. Every screen in the room flashes 'FEELS GOOD MAN' for exactly 4.20 seconds."
                },
                {
                  "op": "say",
                  "text": "Then silence. The tube settles back to its normal glow. Whatever I just did... I'm sure it was fine."
                }
              ]
            }
          ],
          "PUSH": [
            {
              "op": "ifFlag",
              "flag": "pushed_button",
              "then": [
                {
                  "op": "say",
                  "text": "No. Once was enough. I can still see 'FEELS GOOD MAN' burned into my retinas."
                }
              ],
              "else": [
                {
                  "op": "setFlag",
                  "flag": "pushed_button",
                  "value": true
                },
                {
                  "op": "playSound",
                  "key": "keypad_beep"
                },
                {
                  "op": "say",
                  "screen": "virus_screen",
                  "text": "I push the button. The containment tube surges with light. Every screen in the room flashes 'FEELS GOOD MAN' for exactly 4.20 seconds."
                },
                {
                  "op": "say",
                  "text": "Then silence. The tube settles back to its normal glow. Whatever I just did... I'm sure it was fine."
                }
              ]
            }
          ],
          "OPEN": [
            {
              "op": "say",
              "text": "It's a button. The only way into a button is pushing it. That's how they get you."
            }
          ]
        }
      },
      {
        "id": "hs_slime",
        "name": "Green Slime",
        "bounds": {
          "x": 12.4,
          "y": 0,
          "w": 24.4,
          "h": 20.7
        },
        "scripts": {
          "LOOK": [
            {
              "op": "ifFlag",
              "flag": "memelab_clear_vision",
              "then": [
                {
                  "op": "say",
                  "text": "Green slime drips from the ceiling, in time with the tube. Like it's listening to the same song."
                }
              ],
              "else": [
                {
                  "op": "say",
                  "text": "Something drips from above. Green? Red? Blue? All of the above? This anaglyph is giving me a headache."
                }
              ]
            }
          ],
          "USE": [
            {
              "op": "say",
              "text": "I'm not touching the slime. It looks like it has opinions. And a lawyer."
            }
          ],
          "PICK": [
            {
              "op": "say",
              "text": "I am NOT pocketing slime. My pockets have been through enough this week."
            }
          ]
        }
      },
      {
        "id": "hs_pepememe",
        "useResponses": {
          "pepememe": [
            "I put Pepe next to where Pepe was. Now there's a Pepe and the memory of a Pepe."
          ]
        },
        "name": "Rare Pepe",
        "bounds": {
          "x": 77.1,
          "y": 55.3,
          "w": 5.6,
          "h": 14.1
        },
        "scripts": {
          "LOOK": [
            {
              "op": "ifFlag",
              "flag": "memelab_clear_vision",
              "then": [
                {
                  "op": "say",
                  "text": "A rare Pepe printout, wearing 3D glasses just like mine. Good taste. Questionable eyesight. Same as me."
                }
              ],
              "else": [
                {
                  "op": "say",
                  "text": "A green smudge on the desk, doubled in red and blue. It might be a frog. It might be my headache."
                }
              ]
            }
          ],
          "PICK": [
            {
              "op": "ifFlag",
              "flag": "memelab_clear_vision",
              "then": [
                {
                  "op": "ifFlag",
                  "flag": "found_pepememe",
                  "then": [
                    {
                      "op": "say",
                      "text": "I already have the Pepe. One frog per detective. That's the rule."
                    }
                  ],
                  "else": [
                    {
                      "op": "setFlag",
                      "flag": "found_pepememe",
                      "value": true
                    },
                    {
                      "op": "addItem",
                      "id": "pepememe",
                      "name": "Rare Pepe"
                    },
                    {
                      "op": "playSound",
                      "key": "discovery"
                    },
                    {
                      "op": "say",
                      "text": "I carefully pick up the rare Pepe. It feels... warm? Like holding pure meme energy. The eyes seem to follow me."
                    },
                    {
                      "op": "say",
                      "text": "A label on the back: 'SPECIMEN #001 — by P.Z. Do not expose to normies.' P.Z. Same initials as Patient Zero. Coincidence. Surely."
                    }
                  ]
                }
              ],
              "else": [
                {
                  "op": "say",
                  "text": "I grab at a green blur on the desk. Red-blue fringes everywhere. Is it a frog? A stapler? A frog-shaped stapler? I can't tell like this."
                }
              ]
            }
          ],
          "USE": [
            {
              "op": "say",
              "text": "I stare into Pepe's eyes. He stares back through his 3D glasses. 'They're prescription,' we both don't say."
            }
          ],
          "TALK": [
            {
              "op": "say",
              "text": "'Hello, Pepe.' The frog says nothing. Still the best conversation I've had all chapter."
            }
          ]
        }
      },
      {
        "id": "hs_exit_door",
        "name": "Door to Liquidity Pool",
        "bounds": {
          "x": 6,
          "y": 29,
          "w": 5.4,
          "h": 60.6
        },
        "scripts": {
          "LOOK": [
            {
              "op": "say",
              "text": "The door back to the pool. From this side, the apes look almost relaxing."
            }
          ],
          "USE": [
            {
              "op": "sayBrief",
              "text": "Back to the pool.",
              "duration": 800
            },
            { "op": "playSound", "key": "door_creak" },
            {
              "op": "fadeToScene",
              "sceneId": "recovery_pool",
              "spawn": {
                "x": 12.5,
                "y": 98
              }
            }
          ],
          "OPEN": [
            {
              "op": "sayBrief",
              "text": "Back to the pool.",
              "duration": 800
            },
            { "op": "playSound", "key": "door_creak" },
            {
              "op": "fadeToScene",
              "sceneId": "recovery_pool",
              "spawn": {
                "x": 12.5,
                "y": 98
              }
            }
          ]
        }
      },
      {
        "id": "hs_equipment_rack",
        "name": "Analysis Equipment",
        "bounds": {
          "x": 85.2,
          "y": 35.3,
          "w": 3.5,
          "h": 35.2
        },
        "scripts": {
          "LOOK": [
            {
              "op": "ifFlag",
              "flag": "memelab_clear_vision",
              "then": [
                {
                  "op": "say",
                  "text": "Oscilloscopes, analysers and a box labelled 'MEME RESONANCE DETECTOR'. It's resonating. I don't like it."
                }
              ],
              "else": [
                {
                  "op": "say",
                  "text": "Boxy shapes with blinking lights. Equipment of some kind. The anaglyph makes everything look like abstract art."
                }
              ]
            }
          ],
          "USE": [
            {
              "op": "say",
              "text": "I flip a switch. A readout displays: 'CURRENT MEME SENTIMENT: BULLISH'. I flip it back."
            }
          ],
          "OPEN": [
            {
              "op": "say",
              "text": "I open a panel. Wires, and a sticky note: 'IF MEMES ESCAPE, RUN.' I check where the door is."
            }
          ]
        }
      }
    ],
    "triggers": [
      {
        "id": "tr_exit_left",
        "once": false,
        "bounds": {
          "x": 3.9,
          "y": 78.3,
          "w": 2,
          "h": 20
        },
        "onEnter": [
          {
            "op": "fadeToScene",
            "sceneId": "recovery_pool",
            "spawn": {
              "x": 12.5,
              "y": 98
            }
          }
        ]
      }
    ]
  },

{
  "version": 1,
  "id": "mountain",
  "title": "Patient Zero Rehabilitation Clinic",
  "assets": {
    "background": "background.png",
    "foreground": "foreground.png",
    "walkmask": "walkmask.png",
    "atlas": null
  },
  "render": {
    "world": {
      "width": 3712,
      "height": 1152
    },
    "camera": {
      "start": {
        "x": 768,
        "y": 576
      },
      "followPlayer": true,
      "lerp": 0.12,
      "clampToWorld": true
    }
  },
  "player": {
    "spawn": {
      "x": 89.7,
      "y": 95.2
    },
    "speed": 140,
    "sprite": {
      "sheet": null,
      "idle": null,
      "walk": null
    }
  },
  "pixelScale": 3.4,
  "depthScale": { "yTop": 59, "yBottom": 86.5, "scaleTop": 0.75, "scaleBottom": 1 },
  "ui": {
    "verbs": [
      "LOOK",
      "USE",
      "TALK",
      "PICK",
      "OPEN",
      "CLOSE"
    ],
    "mobileDrawerDefault": "collapsed"
  },
  "maskMapping": {
    "walkableColor": "#0000FF",
    "hotspotColor": "#FFFF00",
    "triggerColor": "#FF00FF",
    "regionIdStrategy": "manual"
  },
  "regions": {
    "hotspots": [
      {
        "id": "hs_sign",
        "useResponses": {
          "printout": [
            "I compare the sign to the printout. They agree. That's a first for this investigation."
          ]
        },
        "name": "Clinic Sign",
        "bounds": {
          "x": 35.7,
          "y": 49.5,
          "w": 10.1,
          "h": 15.1
        },
        "scripts": {
          "LOOK": [
            {
              "op": "say",
              "text": "'Patient Zero Rehabilitation Clinic'. Up a mountain. Nobody builds a clinic up a mountain unless they don't want visitors."
            }
          ],
          "USE": [
            {
              "op": "say",
              "text": "Fine print: 'No refunds, no regrets, only recovery.' Two out of three isn't bad."
            }
          ],
          "TALK": [
            {
              "op": "say",
              "text": "The sign doesn't talk. It just points. Smugly."
            }
          ],
          "PICK": [
            {
              "op": "say",
              "text": "It's sunk deep in the rock. Somebody really wanted this sign to stay found."
            }
          ],
          "OPEN": [
            {
              "op": "say",
              "text": "It's a sign. It doesn't open. It just knows things."
            }
          ],
          "CLOSE": [
            {
              "op": "say",
              "text": "Can't close a sign. I can close my eyes. The sign is still there."
            }
          ],
          "PUSH": [
            {
              "op": "say",
              "text": "I push the sign. It wobbles, then holds. Better posture than me."
            }
          ],
          "PULL": [
            {
              "op": "say",
              "text": "I pull the sign. The post is deep in the ground. Someone meant for this to stay."
            }
          ],
          "GIVE": [
            {
              "op": "say",
              "text": "The sign takes nothing. It gives directions. Very old-fashioned."
            }
          ]
        }
      },
      {
        "id": "hs_winding_path",
        "useResponses": {
          "printout": [
            "I hold up the map. The path matches. I don't need to wave it at the path, though. I can just walk."
          ]
        },
        "name": "Winding Path",
        "bounds": {
          "x": 64.6,
          "y": 45.2,
          "w": 10.1,
          "h": 37.6
        },
        "scripts": {
          "LOOK": [
            {
              "op": "say",
              "text": "A long winding path up to the clinic. My calves have already filed a complaint."
            }
          ],
          "USE": [
            {
              "op": "ifHasItem",
              "id": "marked_map",
              "then": [
                {
                  "op": "fadeToScene",
                  "sceneId": "clinic_exterior",
                  "spawn": {
                    "x": 13.8,
                    "y": 95.8
                  }
                }
              ],
              "else": [
                {
                  "op": "ifFlag",
                  "flag": "chapter_3_complete",
                  "then": [
                    {
                      "op": "fadeToScene",
                      "sceneId": "clinic_exterior",
                      "spawn": {
                        "x": 13.8,
                        "y": 95.8
                      }
                    }
                  ],
                  "else": [
                    {
                      "op": "say",
                      "text": "The mountain path forks. Without directions, I could get lost up here for days."
                    }
                  ]
                }
              ]
            }
          ],
          "TALK": [
            {
              "op": "say",
              "text": "'Hello?' The path doesn't answer. A pebble rolls away from me. Rude."
            }
          ],
          "PICK": [
            {
              "op": "say",
              "text": "I can't take the path. I can only take it. ...That's a different 'take'."
            }
          ],
          "OPEN": [
            {
              "op": "say",
              "text": "The path is already open. That's what makes it a path and not a wall."
            }
          ],
          "CLOSE": [
            {
              "op": "say",
              "text": "I can't close a path. I'd need a very long gate."
            }
          ],
          "PUSH": [
            {
              "op": "say",
              "text": "I push on up the path. Each step heavier than the last. I should've stretched."
            }
          ],
          "PULL": [
            {
              "op": "say",
              "text": "I take a step back. The path waits. Paths are patient. Annoyingly."
            }
          ],
          "GIVE": [
            {
              "op": "say",
              "text": "The path doesn't want anything. It just wants me to walk it."
            }
          ]
        }
      },
      {
        "id": "hs_sky",
        "name": "Mountain Sky",
        "bounds": {
          "x": 30,
          "y": 2.4,
          "w": 44.1,
          "h": 14.2
        },
        "scripts": {
          "LOOK": [
            {
              "op": "say",
              "text": "Pink clouds drifting over the peaks. Pretty. Suspiciously pretty. Clinic brochures look like this."
            },
            {
              "op": "setFlag",
              "flag": "debug_look_4",
              "value": true
            }
          ],
          "USE": [
            {
              "op": "say",
              "text": "I squint at the clouds. That one's a duck. That one's... also a duck. Gerald, is that you?"
            }
          ],
          "TALK": [
            {
              "op": "say",
              "text": "I shout a question at the sky. The sky shrugs a cloud at me."
            }
          ],
          "PICK": [
            {
              "op": "say",
              "text": "I reach for a cloud. I'm short by about two kilometres."
            }
          ],
          "OPEN": [
            {
              "op": "say",
              "text": "The sky's already open. Wide open. Showing off, frankly."
            }
          ],
          "CLOSE": [
            {
              "op": "say",
              "text": "I can't close the sky. I can close my eyes. Nap's not on the agenda."
            }
          ],
          "PUSH": [
            {
              "op": "say",
              "text": "I push the sky. My arm gets tired. The sky doesn't."
            }
          ],
          "PULL": [
            {
              "op": "say",
              "text": "I try to pull the clouds closer. They drift off. Even the weather avoids me."
            }
          ],
          "GIVE": [
            {
              "op": "say",
              "text": "I throw my hopes at the sky. They come back down."
            }
          ]
        }
      },
      {
        "id": "hs_trees",
        "name": "Tree Line",
        "bounds": {
          "x": 30.2,
          "y": 17.2,
          "w": 19.5,
          "h": 19.2
        },
        "scripts": {
          "LOOK": [
            {
              "op": "say",
              "text": "Something moves in the pines. A squirrel. Or a spy. Squirrel. ...Probably."
            }
          ],
          "USE": [
            {
              "op": "say",
              "text": "I use the trees for cover. Maybe the clinic staff won't see me coming."
            }
          ],
          "TALK": [
            {
              "op": "say",
              "text": "I whisper to the pines. They whisper back. It's just wind. I tell myself it's just wind."
            }
          ],
          "PICK": [
            {
              "op": "say",
              "text": "I can't take a tree. I tried with a leaf earlier. It went badly."
            }
          ],
          "OPEN": [
            {
              "op": "say",
              "text": "Trees don't open. They do have doors, if you're a squirrel."
            }
          ],
          "CLOSE": [
            {
              "op": "say",
              "text": "I close my eyes under the pines. Still on a mountain. Worth a try."
            }
          ],
          "PUSH": [
            {
              "op": "say",
              "text": "I push into the trees. A branch slaps me back. Fair. I started it."
            }
          ],
          "PULL": [
            {
              "op": "say",
              "text": "I pull a branch. It snaps back. The forest has a no-return policy."
            }
          ],
          "GIVE": [
            {
              "op": "say",
              "text": "The trees only accept carbon dioxide. I give them a sigh. They seem grateful."
            }
          ]
        }
      },
      {
        "id": "hs_spring",
        "keepAfterPick": "El manantial se queda: llenas una botella de agua",
        "useResponses": {
          "_default": [
            "I dip it in the spring. Now it's wet and cold. Like me, on this hike.",
            "The spring doesn't want that. It's a spring. It wants nothing. Very zen.",
            "I'm not dropping that in the spring. It's the cleanest thing for miles."
          ],
          "water_bottle": [
            "The bottle's already full. Fresh mountain water. Fernando would weep."
          ],
          "energy_drink": [
            "I'm not mixing BULL RUN into a mountain spring. The fish have enough problems."
          ]
        },
        "name": "Mountain Spring",
        "bounds": {
          "x": 16.1,
          "y": 19.7,
          "w": 12,
          "h": 15
        },
        "scripts": {
          "LOOK": [
            {
              "op": "say",
              "text": "Crystal-clear water trickling out of the rocks. The cleanest thing I've seen all week. Including me."
            }
          ],
          "USE": [
            {
              "op": "say",
              "text": "I splash my face. Cold! Very cold. I'm awake. I'm extremely awake."
            }
          ],
          "TALK": [
            {
              "op": "say",
              "text": "The water babbles. I nod along. Good listener, bad conversationalist."
            }
          ],
          "PICK": [
            {
              "op": "ifFlag",
              "flag": "has_water",
              "then": [
                {
                  "op": "say",
                  "text": "I already filled a bottle."
                }
              ],
              "else": [
                {
                  "op": "setFlag",
                  "flag": "has_water",
                  "value": true
                },
                {
                  "op": "addItem",
                  "id": "water_bottle",
                  "name": "Spring Water"
                },
                {
                  "op": "say",
                  "text": "I fill the bottle. Fresh mountain water. The cleanest thing I own."
                }
              ]
            }
          ],
          "OPEN": [
            {
              "op": "say",
              "text": "It's a spring. It's been open since the Ice Age."
            }
          ],
          "CLOSE": [
            {
              "op": "say",
              "text": "I put my thumb over it. The water goes round my thumb. Water always wins."
            }
          ],
          "PUSH": [
            {
              "op": "say",
              "text": "I push the rock. The water keeps flowing. The rock keeps rocking."
            }
          ],
          "PULL": [
            {
              "op": "say",
              "text": "I can't pull water uphill. I've tried. Ask my plumber."
            }
          ],
          "GIVE": [
            {
              "op": "say",
              "text": "The spring gives ME water. Not the other way around."
            }
          ]
        }
      },
      {
        "id": "hs_building",
        "name": "Clinic Cabin",
        "bounds": {
          "x": 70.8,
          "y": 15,
          "w": 16,
          "h": 20
        },
        "scripts": {
          "LOOK": [
            {
              "op": "say",
              "text": "A cabin on the hillside, warm light in the window, smoke from the chimney. Someone's home. Someone's always home in these stories."
            }
          ],
          "USE": [
            {
              "op": "say",
              "text": "Too far away. I need to follow the winding path up there."
            }
          ],
          "TALK": [
            {
              "op": "say",
              "text": "'HELLO!' The mountains echo back: '...LO... LO... LO...' Nobody comes out. Classic."
            }
          ],
          "PICK": [
            {
              "op": "say",
              "text": "I hold up two fingers and pinch the cabin. Got it. ...I don't have it."
            }
          ],
          "OPEN": [
            {
              "op": "say",
              "text": "I need to get up there first. The path is the only way."
            }
          ],
          "CLOSE": [
            {
              "op": "say",
              "text": "I can't close a building from down here. My arms aren't that long."
            }
          ],
          "PUSH": [
            {
              "op": "say",
              "text": "I picture myself at the door. My body stays exactly where it is. Visualisation is a scam."
            }
          ],
          "PULL": [
            {
              "op": "say",
              "text": "I try to will the cabin closer. It stays put. Buildings don't come to you."
            }
          ],
          "GIVE": [
            {
              "op": "say",
              "text": "I'd give anything to be up there already. But the mountain demands the journey."
            }
          ]
        }
      },
      {
        "id": "hs_warning_signs",
        "name": "Warning Signs",
        "bounds": {
          "x": 31.5,
          "y": 52.9,
          "w": 3.4,
          "h": 12.7
        },
        "scripts": {
          "LOOK": [
            {
              "op": "say",
              "text": "Signs along the path: 'TURN BACK'. 'NO, REALLY'. 'LAST CHANCE TO TAKE PROFIT'. The clinic knows its patients."
            }
          ],
          "USE": [
            {
              "op": "say",
              "text": "I try to rotate a sign so it says 'COME IN'. Bolted down. Somebody thought of that."
            }
          ],
          "TALK": [
            {
              "op": "say",
              "text": "'Is it really that bad up there?' The signs don't say. Well. They do. In capitals."
            }
          ],
          "PICK": [
            {
              "op": "say",
              "text": "These signs are cemented into the ground. Not going anywhere."
            }
          ],
          "OPEN": [
            {
              "op": "say",
              "text": "They're signs, not doors. They only open minds. Mine stays shut."
            }
          ],
          "CLOSE": [
            {
              "op": "say",
              "text": "You can't close a warning. You can only ignore it. That's my specialty."
            }
          ]
        }
      },
      {
        "id": "hs_boulders",
        "name": "Boulders",
        "walkTo": {
          "x": 88,
          "y": 91
        },
        "bounds": {
          "x": 82,
          "y": 55,
          "w": 14,
          "h": 25
        },
        "scripts": {
          "LOOK": [
            {
              "op": "say",
              "text": "Huge mossy boulders. They've been here since before money. They look like they're waiting for someone."
            }
          ],
          "USE": [
            {
              "op": "say",
              "text": "I lean against a boulder. It's warm from the sunset. Best chair on the mountain."
            }
          ],
          "TALK": [
            {
              "op": "say",
              "text": "'Seen a man in a coat go by? About three weeks ago?' The boulder keeps its counsel."
            }
          ],
          "PICK": [
            {
              "op": "say",
              "text": "Several tons each. My pockets are good, but they're not that good."
            }
          ],
          "OPEN": [
            {
              "op": "say",
              "text": "One boulder has a crack full of quartz crystals. Pretty. Not a clue. I asked."
            }
          ],
          "CLOSE": [
            {
              "op": "say",
              "text": "I can't close a boulder. It's a rock. It's already as closed as it gets."
            }
          ],
          "PUSH": [
            {
              "op": "say",
              "text": "I push the boulder. It doesn't move. Sisyphus and I should start a support group."
            }
          ],
          "PULL": [
            {
              "op": "say",
              "text": "I pull a small rock loose. It tumbles down the slope. 'SORRY!' Nobody answers. Good. I think."
            }
          ],
          "GIVE": [
            {
              "op": "say",
              "text": "Boulders don't take gifts. They take millennia. I'm in a hurry."
            }
          ]
        }
      },
      {
        "id": "hs_mountain_range",
        "name": "Purple Mountains",
        "bounds": {
          "x": 0,
          "y": 8,
          "w": 15,
          "h": 18
        },
        "scripts": {
          "LOOK": [
            {
              "op": "say",
              "text": "Purple peaks against the sunset. They look like a chart. ...They look like mountains. I'm working on it."
            }
          ],
          "USE": [
            {
              "op": "say",
              "text": "I can't use mountains. They use ME. For scale."
            }
          ],
          "TALK": [
            {
              "op": "say",
              "text": "I yodel. The mountains yodel back, slightly better. Show-offs."
            }
          ],
          "PICK": [
            {
              "op": "say",
              "text": "I try to pick a mountain. Even God needed six days to make these. I have maybe six minutes."
            }
          ],
          "OPEN": [
            {
              "op": "say",
              "text": "If I could open a mountain, there'd be a dragon inside. I'm not opening a mountain."
            }
          ],
          "CLOSE": [
            {
              "op": "say",
              "text": "Mountains don't close. They don't even have opening hours."
            }
          ],
          "PUSH": [
            {
              "op": "say",
              "text": "I push toward the mountains. They stay exactly that far away. Mountains are like that."
            }
          ],
          "PULL": [
            {
              "op": "say",
              "text": "Tectonic plates already pull mountains. Millions of years. I'll let them handle it."
            }
          ],
          "GIVE": [
            {
              "op": "say",
              "text": "The mountains want nothing from me. First thing all week that doesn't."
            }
          ]
        }
      },
      {
        "id": "hs_wildflowers",
        "name": "Mountain Wildflowers",
        "bounds": {
          "x": 0,
          "y": 78,
          "w": 9.9,
          "h": 12
        },
        "scripts": {
          "LOOK": [
            {
              "op": "say",
              "text": "Wildflowers, gold and white. Growing up a mountain with no help from anyone. Fernando would be jealous."
            }
          ],
          "USE": [
            {
              "op": "say",
              "text": "I smell the flowers. For a moment I forget everything. ...Which, apparently, I'm good at."
            }
          ],
          "TALK": [
            {
              "op": "say",
              "text": "I tell the flowers they're doing great. Penny says it works on Fernando."
            }
          ],
          "PICK": [
            {
              "op": "say",
              "text": "I pick a wildflower. It wilts in my hand. I'm a bad influence. Even on flowers."
            }
          ],
          "OPEN": [
            {
              "op": "say",
              "text": "I open a bud. A very small, very angry bee flies out. I apologise to the bee."
            }
          ],
          "CLOSE": [
            {
              "op": "say",
              "text": "Flowers close at night by themselves. Better bedtime routine than mine."
            }
          ],
          "PUSH": [
            {
              "op": "say",
              "text": "I push through the flowers. They spring right back up. No hard feelings."
            }
          ],
          "PULL": [
            {
              "op": "say",
              "text": "I pull a flower. Its roots hold firm. It's not leaving the mountain. Smart flower."
            }
          ],
          "GIVE": [
            {
              "op": "say",
              "text": "The flowers give ME oxygen. I'm not sure what I bring to this relationship."
            }
          ]
        }
      }
    ],

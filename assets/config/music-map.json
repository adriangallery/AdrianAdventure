  "rules": [
    {
      "state": "solved",
      "priority": 60,
      "when": {
        "transient": "solved"
      }
    },
    {
      "state": "duel",
      "priority": 55,
      "when": {
        "dialogueTree": [
          "chad_fud",
          "pzbot_final"
        ]
      }
    },
    {
      "state": "dialogue",
      "priority": 50,
      "when": {
        "dialogue": true
      }
    },
    {
      "state": "danger",
      "priority": 40,
      "when": {
        "scene": "server_room",
        "notFlag": "pzbot_off"
      }
    },
    {
      "state": "danger",
      "priority": 40,
      "when": {
        "scene": "treatment_room",
        "flag": "admitted"
      }
    },
    {
      "state": "tension",
      "priority": 30,
      "when": {
        "scene": [
          "basement",
          "memelab"
        ]
      }
    },
    {
      "state": "tension",
      "priority": 25,
      "when": {
        "item": "keycard",
        "scene": [
          "clinic_interior",
          "recovery_pool"
        ]
      }
    },
    {
      "state": "chapterEnd",
      "priority": 20,
      "when": {
        "goalsLeftMax": 1
      }
    }
  ],

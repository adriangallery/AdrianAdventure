{
  "$comment": "A8.1 música adaptativa (iMUSE). `tracks` lo mide scripts/audio/analyze-tempo.mjs (no editar a mano); el resto es a mano: planner (espera máxima), rules (estado del juego → estado musical, gana la prioridad mayor), states (capas y sección por estado), places (arreglo del motivo por escena). Ver docs/progreso/A8.1.md.",
  "planner": {
    "maxWaitBars": 2,
    "phraseBars": 2,
    "minLeadSec": 0.12,
    "solvedBars": 4
  },
  "rules": [
    {
      "state": "solved",
      "priority": 60,
      "when": {
        "transient": "solved"
      }
    },
    {
      "state": "dialogue",
      "priority": 50,
      "when": {
        "dialogue": true
      }
    },
    {
      "state": "danger",
      "priority": 40,
      "when": {
        "scene": "server_room",
        "notFlag": "pzbot_off"
      }
    },
    {
      "state": "danger",
      "priority": 40,
      "when": {
        "scene": "treatment_room",
        "flag": "admitted"
      }
    },
    {
      "state": "tension",
      "priority": 30,
      "when": {
        "scene": [
          "basement",
          "memelab"
        ]
      }
    },
    {
      "state": "tension",
      "priority": 25,
      "when": {
        "item": "keycard",
        "scene": [
          "clinic_interior",
          "recovery_pool"
        ]
      }
    },
    {
      "state": "chapterEnd",
      "priority": 20,
      "when": {
        "goalsLeftMax": 1
      }
    }
  ],
  "states": {
    "explore": {
      "layers": [
        "motif"
      ],
      "section": "any",
      "gain": 1
    },
    "dialogue": {
      "layers": [
        "pad"
      ],
      "section": "calm",
      "gain": 0.8
    },
    "tension": {
      "layers": [
        "pulse",
        "tick"
      ],
      "section": "intense",
      "gain": 1
    },
    "danger": {
      "layers": [
        "pulse",
        "tick",
        "motif"
      ],
      "section": "intense",
      "gain": 1
    },
    "solved": {
      "layers": [
        "motif",
        "pad"
      ],
      "section": "any",
      "gain": 1
    },
    "chapterEnd": {
      "layers": [
        "pad",
        "pulse"
      ],
      "section": "any",
      "gain": 1
    }
  },

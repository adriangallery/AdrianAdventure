      "steps": [
        { "do": "newGame", "expect": { "scene": "outside", "lacks": ["printout"] } },
        { "do": "walk", "x": 1.5, "y": 95, "trigger": "tr_mountain", "untilScene": "mountain", "gate": true, "note": "A1.2 cierra aquí la salida: sin printout ni chapter_3_complete el personaje se para y lo explica", "expect": { "scene": "mountain" } },

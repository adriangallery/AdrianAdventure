{
  "title": "Atajos de secuencia: llegar antes de tiempo debe ser imposible",
  "routes": [
    {
      "id": "clinica-sin-printout",
      "kind": "sequence-break",
      "title": "outside → mountain → clinic_exterior desde el minuto 1, sin el printout del capítulo 3",
      "why": "atajo cerrado en A1.2: outside.tr_mountain y mountain.tr_to_clinic piden el printout o chapter_3_complete, como hs_winding_path",
      "goal": { "scene": "clinic_exterior" },
      "steps": [
        { "do": "newGame", "expect": { "scene": "outside", "lacks": ["printout"] } },
        { "do": "walk", "x": 1.5, "y": 95, "trigger": "tr_mountain", "untilScene": "mountain", "gate": true, "note": "A1.2 cierra aquí la salida: sin printout ni chapter_3_complete el personaje se para y lo explica", "expect": { "scene": "mountain" } },
        { "do": "walk", "x": 21, "y": 65, "trigger": "tr_to_clinic", "untilScene": "clinic_exterior", "attempt": true, "note": "tr_chapter4_intro para al personaje a medio camino" }
      ]
    },
    {
      "id": "recepcion-clinica-sin-capitulo-3",
      "kind": "sequence-break",
      "title": "Recepción de la clínica (capítulo 4) sin haber pasado por el sótano",
      "why": "mismo atajo de montaña (cerrado en A1.2) + la hoja de visitas de clinic_exterior abre la puerta sin keycard",
      "goal": { "scene": "clinic_interior" },
      "steps": [
        { "do": "newGame", "expect": { "scene": "outside", "lacks": ["keycard"], "flags": { "chapter_3_complete": false } } },
        { "do": "walk", "x": 1.5, "y": 95, "trigger": "tr_mountain", "untilScene": "mountain", "gate": true, "expect": { "scene": "mountain" } },
        { "do": "walk", "x": 21, "y": 65, "trigger": "tr_to_clinic", "untilScene": "clinic_exterior", "gate": true, "expect": { "scene": "clinic_exterior" } },
        { "do": "act", "verb": "PICK", "target": "hs_visitor_box", "expect": { "scene": "clinic_exterior", "has": ["sign_in_sheet"], "flags": { "found_sign_in_sheet": true } } },
        { "do": "act", "verb": "USE", "target": "hs_main_entrance", "attempt": true, "expect": { "scene": "clinic_exterior" } }
      ]
    },
    {
      "id": "montana-con-keycard-sin-capitulo-3",
      "kind": "sequence-break",
      "title": "La montaña a mitad del capítulo 2, con la keycard pero sin sótano ni printout",
      "why": "A1.2: la keycard (que abre la clínica) no debe abrir el camino de la montaña; outside.tr_mountain pide el printout o chapter_3_complete",
      "goal": { "scene": "mountain" },
      "steps": [
        { "do": "newGame", "expect": { "scene": "outside" } },
        { "do": "act", "verb": "USE", "target": "hs_porch_light", "note": "A3.3c: la mitad A del PIN (apagar la lámpara, cogerla)", "expect": { "flags": { "porch_light_off": true } } },
        { "do": "act", "verb": "PICK", "target": "hs_porch_light", "expect": { "has": ["note_half_a"] } },
        { "do": "act", "verb": "PULL", "target": "hs_fence", "note": "A3.3c: el tablón y, con él, el nido de la chimenea (mitad B)", "expect": { "has": ["fence_plank"] } },
        { "do": "use", "item": "fence_plank", "target": "hs_chimney", "expect": { "has": ["note_half_b"] } },
        { "do": "combine", "items": ["note_half_a", "note_half_b"], "expect": { "has": ["code_note"] } },
        { "do": "use", "item": "code_note", "target": "hs_keypad", "expect": { "scene": "lobby", "flags": { "chapter_1_complete": true } } },
        { "do": "act", "verb": "PICK", "target": "hs_coat", "expect": { "has": ["keycard"] } },
        { "do": "act", "verb": "USE", "target": "hs_frontdoor", "expect": { "scene": "outside", "has": ["keycard"], "lacks": ["printout"], "flags": { "chapter_3_complete": false } } },
        { "do": "walk", "x": 1.5, "y": 95, "trigger": "tr_mountain", "untilScene": "mountain", "attempt": true }
      ]
    },
    {
      "id": "montana-con-capitulo-3-a-medias",
      "kind": "sequence-break",
      "title": "La montaña desde el sótano (capítulo 3 empezado, sin printout ni chapter_3_complete)",
      "why": "A1.2: volver del sótano por el lobby a la calle no debe abrir la montaña antes de acabar el capítulo 3",
      "goal": { "scene": "mountain" },
      "steps": [
        { "do": "newGame", "expect": { "scene": "outside" } },
        { "do": "act", "verb": "USE", "target": "hs_porch_light", "note": "A3.3c: la mitad A del PIN (apagar la lámpara, cogerla)", "expect": { "flags": { "porch_light_off": true } } },
        { "do": "act", "verb": "PICK", "target": "hs_porch_light", "expect": { "has": ["note_half_a"] } },
        { "do": "act", "verb": "PULL", "target": "hs_fence", "note": "A3.3c: el tablón y, con él, el nido de la chimenea (mitad B)", "expect": { "has": ["fence_plank"] } },
        { "do": "use", "item": "fence_plank", "target": "hs_chimney", "expect": { "has": ["note_half_b"] } },
        { "do": "combine", "items": ["note_half_a", "note_half_b"], "expect": { "has": ["code_note"] } },
        { "do": "use", "item": "code_note", "target": "hs_keypad", "expect": { "scene": "lobby" } },
        { "do": "act", "verb": "PICK", "target": "hs_coat", "expect": { "has": ["keycard"] } },
        { "do": "act", "verb": "USE", "target": "hs_stairs_up", "expect": { "scene": "upstairs" } },
        { "do": "act", "verb": "USE", "target": "hs_roof_hatch", "expect": { "scene": "rooftop" } },
        { "do": "act", "verb": "USE", "target": "hs_weather_vane", "expect": { "flags": { "vane_turned": true } } },
        { "do": "act", "verb": "LOOK", "target": "hs_basement_light", "expect": { "flags": { "chapter_2_complete": true } } },
        { "do": "act", "verb": "USE", "target": "hs_roof_access_panel", "expect": { "scene": "basement", "flags": { "basement_unlocked": true } } },
        { "do": "act", "verb": "USE", "target": "hs_stairs", "expect": { "scene": "lobby" } },
        { "do": "act", "verb": "USE", "target": "hs_frontdoor", "expect": { "scene": "outside", "lacks": ["printout"], "flags": { "chapter_2_complete": true, "chapter_3_complete": false } } },
        { "do": "walk", "x": 1.5, "y": 95, "trigger": "tr_mountain", "untilScene": "mountain", "attempt": true }
      ]
    },
    {
      "id": "sotano-sin-keycard",
      "kind": "sequence-break",
      "title": "Control: el sótano por la azotea sin la keycard del abrigo",
      "why": "hs_roof_access_panel exige has_keycard; esta ruta debe quedarse fuera",
      "goal": { "scene": "basement" },
      "steps": [
        { "do": "newGame", "expect": { "scene": "outside" } },
        { "do": "act", "verb": "USE", "target": "hs_porch_light", "note": "A3.3c: la mitad A del PIN (apagar la lámpara, cogerla)", "expect": { "flags": { "porch_light_off": true } } },
        { "do": "act", "verb": "PICK", "target": "hs_porch_light", "expect": { "has": ["note_half_a"] } },
        { "do": "act", "verb": "PULL", "target": "hs_fence", "note": "A3.3c: el tablón y, con él, el nido de la chimenea (mitad B)", "expect": { "has": ["fence_plank"] } },
        { "do": "use", "item": "fence_plank", "target": "hs_chimney", "expect": { "has": ["note_half_b"] } },
        { "do": "combine", "items": ["note_half_a", "note_half_b"], "expect": { "has": ["code_note"] } },
        { "do": "use", "item": "code_note", "target": "hs_keypad", "expect": { "scene": "lobby" } },
        { "do": "act", "verb": "USE", "target": "hs_stairs_up", "expect": { "scene": "upstairs", "lacks": ["keycard"] } },
        { "do": "act", "verb": "USE", "target": "hs_roof_hatch", "expect": { "scene": "rooftop" } },
        { "do": "act", "verb": "USE", "target": "hs_weather_vane", "expect": { "scene": "rooftop", "flags": { "vane_turned": true, "has_keycard": false } } },
        { "do": "act", "verb": "USE", "target": "hs_roof_access_panel", "attempt": true, "rejects": "keycard reader still blinks red", "expect": { "scene": "rooftop", "lacks": ["keycard"] } }
      ]
    },
    {
      "id": "nota-con-lampara-encendida",
      "kind": "sequence-break",
      "title": "A3.3c: la mitad A de la nota sin apagar la lámpara del porche",
      "why": "A3.3c (puzle 1.1): con la luz encendida PICK/OPEN de hs_porch_light solo dicen «Hot. Hot hot hot.»; la mitad A sale con porch_light_off",
      "goal": { "has": ["note_half_a"] },
      "steps": [
        { "do": "newGame", "expect": { "scene": "outside", "lacks": ["note_half_a"], "unsetFlags": ["porch_light_off"] } },
        { "do": "act", "verb": "OPEN", "target": "hs_porch_light", "rejects": "Hot\\. Hot hot hot", "expect": { "lacks": ["note_half_a"], "unsetFlags": ["porch_light_off", "found_note_half_a"] } },
        { "do": "act", "verb": "PICK", "target": "hs_porch_light", "attempt": true, "rejects": "Hot\\. Hot hot hot", "expect": { "lacks": ["note_half_a"], "unsetFlags": ["found_note_half_a"] } }
      ]
    },
    {
      "id": "nido-sin-tablon",
      "kind": "sequence-break",
      "title": "A3.3c: la mitad B (nido de urraca) sin el tablón de la valla",
      "why": "A3.3c (puzle 1.3): la chimenea solo suelta el nido con el combo fence_plank + hs_chimney; USE, PULL y PICK sin tablón no dan nada",
      "goal": { "has": ["note_half_b"] },
      "steps": [
        { "do": "newGame", "expect": { "scene": "outside", "lacks": ["fence_plank", "note_half_b"] } },
        { "do": "act", "verb": "USE", "target": "hs_chimney", "expect": { "lacks": ["note_half_b"], "unsetFlags": ["nest_down"] } },
        { "do": "act", "verb": "PULL", "target": "hs_chimney", "rejects": "something long", "note": "antes de A3.3c el PULL decía «A bird's nest falls out» sin dar nada", "expect": { "lacks": ["note_half_b"], "unsetFlags": ["nest_down"] } },
        { "do": "act", "verb": "PICK", "target": "hs_chimney", "attempt": true, "rejects": "Too high", "expect": { "lacks": ["note_half_b"], "unsetFlags": ["nest_down", "found_note_half_b"] } }
      ]
    },
    {
      "id": "puerta-con-media-nota",
      "kind": "sequence-break",
      "title": "A3.3c: abrir la puerta con media nota (note_half_a en el teclado)",
      "why": "A3.3c (puzle 1.4): solo code_note (las dos mitades juntas) abre; la mitad A en el teclado es una respuesta de fallo",
      "goal": { "scene": "lobby" },
      "steps": [
        { "do": "newGame", "expect": { "scene": "outside", "lacks": ["code_note"] } },
        { "do": "act", "verb": "USE", "target": "hs_porch_light", "expect": { "flags": { "porch_light_off": true } } },
        { "do": "act", "verb": "PICK", "target": "hs_porch_light", "expect": { "has": ["note_half_a"], "lacks": ["code_note"] } },
        { "do": "use", "item": "note_half_a", "target": "hs_keypad", "attempt": true, "rejects": "Half a code opens half a door", "expect": { "scene": "outside", "flags": { "door_unlocked": false, "has_code": false } } }
      ]
    }
  ]
}

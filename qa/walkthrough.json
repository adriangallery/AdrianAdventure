{
  "title": "Ruta crítica: New Game → créditos (sin wallet)",
  "routes": [
    {
      "id": "ruta-critica",
      "kind": "walkthrough",
      "title": "Los 5 capítulos y el epílogo sin wallet conectada",
      "goal": { "scene": "epilogue_outside", "flags": { "game_complete": true } },
      "steps": [
        { "do": "newGame", "expect": { "scene": "outside", "flags": { "premise_shown": true, "chapter_1_intro_shown": true } } },

        { "do": "act", "verb": "USE", "target": "hs_front_door", "rejects": "keypad blinks red", "note": "A1.4: sin la nota, la lámpara parpadea (op flicker sobre el overlay lamp_empty) sin escribir found_code_note en la partida", "expect": { "lacks": ["code_note"], "flags": { "has_code": false, "door_unlocked": false }, "unsetFlags": ["found_code_note"] } },
        { "do": "act", "verb": "PICK", "target": "hs_porch_light", "note": "A1.4: parpadeo con flicker y una sola escritura real de found_code_note", "expect": { "has": ["code_note"], "flags": { "has_code": true, "found_code_note": true } } },
        { "do": "act", "verb": "PICK", "target": "hs_doormat", "note": "el Ledger se usa en el capítulo 3", "expect": { "has": ["ledger"] } },
        { "do": "act", "verb": "PICK", "target": "hs_mailbox", "holdTextMs": 35000, "note": "A2.2: walkTo y face explícitos en outside (a la izquierda del buzón, mirando a la derecha). el sobre abre el diálogo con Dr. Satoshi en el capítulo 4. A1.1: el texto se deja 35 s en pantalla antes del addItem y el setFlag; el watchdog no debe cortar el script", "expect": { "has": ["mystery_envelope"], "flags": { "found_envelope": true }, "facing": "right" } },
        { "do": "use", "item": "code_note", "target": "hs_keypad", "expect": { "scene": "lobby", "flags": { "door_unlocked": true, "chapter_1_complete": true, "chapter_2_intro_shown": true } } },

        { "do": "act", "verb": "PICK", "target": "hs_coat", "note": "A2.2: anda hasta debajo del abrigo (antes no andaba) y se gira de espaldas; por el camino pisa tr_lobby_first_visit, que lo para y al acabar su script retoma el camino", "expect": { "has": ["keycard"], "flags": { "has_keycard": true }, "facing": "back" } },
        { "do": "talk", "npc": "npc_receptionist", "choices": ["Patient Zero", "nervous", "come back later"], "note": "A1.8 (QA antigua 4): la recepcionista se puede pulsar (hit-test del sprite antes que hs_monitor_desk, que la rodea) y su diálogo llega hasta el onEnter de patient_zero. A2.6: la rama vuelve al hub, «What about Patient Zero?» sale en gris (usada) y la salida explícita cierra la conversación", "expect": { "scene": "lobby", "flags": { "receptionist_mentioned_pz": true }, "facing": "left", "lastChoices": { "used": ["What about Patient Zero"], "fresh": ["The tour", "What experiments", "come back later"], "locked": ["Show my badge"] } } },
        { "do": "act", "verb": "PUSH", "target": "hs_poster", "rejects": "can't push that", "note": "A1.8 (QA antigua 5): PUSH sin script en el hotspot responde con el texto por defecto, no en silencio", "expect": { "scene": "lobby" } },
        { "do": "act", "verb": "PULL", "target": "hs_poster", "rejects": "can't pull that", "note": "A1.8 (QA antigua 5): PULL sin script, texto por defecto", "expect": { "scene": "lobby" } },
        { "do": "act", "verb": "GIVE", "target": "hs_poster", "rejects": "nobody to give that to", "note": "A1.8 (QA antigua 5): GIVE sin objeto ni script, texto por defecto", "expect": { "scene": "lobby" } },
        { "do": "act", "verb": "USE", "target": "hs_stairs_up", "expect": { "scene": "upstairs" } },
        { "do": "act", "verb": "OPEN", "target": "hs_desk", "note": "A1.4: la flag del cajón se llama found_terminal_key (antes found_hw_wallet)", "expect": { "has": ["terminal_key"], "flags": { "found_terminal_key": true }, "unsetFlags": ["found_hw_wallet"] } },
        { "do": "act", "verb": "PICK", "target": "hs_energy_drink", "expect": { "has": ["energy_drink"] } },
        { "do": "act", "verb": "USE", "target": "hs_roof_hatch", "expect": { "scene": "rooftop" } },
        { "do": "resize", "width": 844, "height": 390, "note": "A1.10: tras 3 cambios de escena, una redimensión (móvil apaisado) no da errores de consola y los listeners de resize no crecen", "expect": { "scene": "rooftop", "noListenerGrowth": true } },
        { "do": "resize", "width": 1280, "height": 720, "note": "A1.10: vuelta al viewport de la ruta", "expect": { "scene": "rooftop", "noListenerGrowth": true } },

        { "do": "act", "verb": "PICK", "target": "hs_antenna_array", "expect": { "has": ["antenna"] } },
        { "do": "act", "verb": "USE", "target": "hs_weather_vane", "expect": { "flags": { "vane_turned": true } } },
        { "do": "act", "verb": "LOOK", "target": "hs_basement_light", "expect": { "flags": { "chapter_2_complete": true } } },
        { "do": "act", "verb": "USE", "target": "hs_roof_access_panel", "expect": { "scene": "basement", "flags": { "basement_unlocked": true, "chapter_3_intro_shown": true } } },

        { "do": "act", "verb": "PICK", "target": "hs_left_desk", "expect": { "has": ["floppy_disk"] } },
        { "do": "use", "item": "energy_drink", "target": "hs_main_computer", "expect": { "lacks": ["energy_drink"], "flags": { "crt_powered": true } } },
        { "do": "act", "verb": "PUSH", "target": "hs_equipment", "expect": { "scene": "server_room", "flags": { "server_room_open": true } } },

        { "do": "act", "verb": "PICK", "target": "hs_server_rack_b", "expect": { "has": ["burned_chip"] } },
        { "do": "use", "item": "antenna", "target": "hs_emergency_switch", "expect": { "flags": { "emergency_glass_broken": true } } },
        { "do": "act", "verb": "USE", "target": "hs_emergency_switch", "expect": { "flags": { "emergency_switch_flipped": true, "chapter_3_complete": true } } },
        { "do": "walk", "x": 8, "y": 95, "trigger": "tr_to_basement", "untilScene": "basement", "note": "salida a pie por tr_to_basement", "expect": { "scene": "basement" } },

        { "do": "use", "item": "burned_chip", "target": "hs_main_computer", "expect": { "lacks": ["burned_chip"], "flags": { "crt_repaired": true } } },
        { "do": "use", "item": "ledger", "target": "hs_main_computer", "expect": { "flags": { "computer_unlocked": true } } },
        { "do": "use", "item": "floppy_disk", "target": "hs_main_computer", "expect": { "has": ["printout"], "lacks": ["floppy_disk"], "flags": { "has_printout": true } } },
        { "do": "act", "verb": "USE", "target": "hs_stairs", "expect": { "scene": "lobby" } },
        { "do": "act", "verb": "USE", "target": "hs_frontdoor", "expect": { "scene": "outside" } },

        { "do": "walk", "x": 1.5, "y": 95, "trigger": "tr_mountain", "untilScene": "mountain", "note": "salida a pie por tr_mountain", "expect": { "scene": "mountain", "flags": { "chapter_4_intro_shown": true } } },
        { "do": "act", "verb": "USE", "target": "hs_winding_path", "expect": { "scene": "clinic_exterior" } },
        { "do": "act", "verb": "USE", "target": "hs_main_entrance", "expect": { "scene": "clinic_interior" } },
        { "do": "resize", "width": 390, "height": 844, "note": "A1.10: tras 11 cambios de escena, otra redimensión (móvil vertical) sin errores y sin listeners acumulados", "expect": { "scene": "clinic_interior", "noListenerGrowth": true } },
        { "do": "resize", "width": 1280, "height": 720, "note": "A1.10: vuelta al viewport de la ruta", "expect": { "scene": "clinic_interior", "noListenerGrowth": true } },
        { "do": "talk", "npc": "npc_dr_satoshi", "choices": ["confidential documents", "In a mailbox", "Goodbye, doctor"], "note": "A1.9: el onEnter de evidence_accepted quita el sobre y da el logro del capítulo 4 en el momento (antes solo ponía los flags). A2.6: vuelve al hub; la opción del sobre (when: found_envelope, !treatment_room_unlocked) ya no sale y «Goodbye, doctor.» es la salida", "expect": { "lastChoices": { "absent": ["confidential documents"], "fresh": ["Goodbye, doctor"] },  "flags": { "treatment_room_unlocked": true, "chapter_4_complete": true }, "lacks": ["mystery_envelope"], "achievements": ["ch4_complete"] } },

        { "do": "act", "verb": "USE", "target": "hs_treatment_door", "expect": { "scene": "treatment_room", "flags": { "chapter_5_intro_shown": true } } },
        { "do": "act", "verb": "USE", "target": "hs_monitor", "expect": { "flags": { "monitor_revealed": true, "patient_zero_revealed": true, "chapter_5_complete": true } } },
        { "do": "act", "verb": "USE", "target": "hs_exit_door", "expect": { "scene": "epilogue_outside", "flags": { "game_complete": true } } },
        { "do": "act", "verb": "USE", "target": "hs_path_forward", "note": "créditos", "expect": { "scene": "epilogue_outside", "flags": { "game_complete": true } } }
      ]
    },
    {
      "id": "controles-escritorio",
      "kind": "walkthrough",
      "title": "A2.4: teclado y ratón de escritorio en el lobby (Tab, atajos de verbos, clic derecho, Esc y doble clic en una salida)",
      "goal": { "scene": "upstairs", "has": ["keycard"] },
      "steps": [
        { "do": "newGame", "expect": { "scene": "outside" } },
        { "do": "act", "verb": "PICK", "target": "hs_porch_light", "expect": { "has": ["code_note"] } },
        { "do": "use", "item": "code_note", "target": "hs_keypad", "expect": { "scene": "lobby" } },

        { "do": "key", "key": "Tab", "phase": "down", "note": "mantener Tab: resalta los hotspots que se pueden pulsar y la NPC", "expect": { "highlighted": { "min": 6, "includes": ["hs_stairs_up", "hs_frontdoor", "hs_coat", "hs_plant", "npc_receptionist"] } } },
        { "do": "key", "key": "Tab", "phase": "up", "note": "al soltar Tab se quita", "expect": { "highlighted": { "max": 0 } } },
        { "do": "key", "key": "l", "note": "L = Look at en el panel", "expect": { "verb": "LOOK" } },
        { "do": "click", "target": "hs_plant", "note": "clic izquierdo con el verbo elegido por teclado: mira la planta", "expect": { "verb": "LOOK", "walkTarget": { "target": "hs_plant", "verb": "LOOK" } } },
        { "do": "key", "key": "l", "note": "la tecla del verbo ya elegido lo suelta (vuelve a Walk), como en el panel", "expect": { "verb": "WALK" } },
        { "do": "rightclick", "target": "npc_receptionist", "choices": ["come back later"], "note": "clic derecho en una NPC = hablar (sin elegir verbo)", "expect": { "verb": "WALK", "walkTarget": { "target": "npc_receptionist", "verb": "TALK" } } },
        { "do": "rightclick", "target": "hs_floor_tiles", "note": "clic derecho en algo que solo tiene texto = mirar", "expect": { "walkTarget": { "target": "hs_floor_tiles", "verb": "LOOK" } } },
        { "do": "rightclick", "target": "hs_coat", "note": "clic derecho en algo que se coge = coger", "expect": { "has": ["keycard"], "walkTarget": { "target": "hs_coat", "verb": "PICK" } } },
        { "do": "key", "key": "u", "expect": { "verb": "USE" } },
        { "do": "key", "key": "Escape", "note": "Esc sin cinemática suelta el verbo elegido", "expect": { "verb": "WALK" } },
        { "do": "doubleclick", "target": "hs_stairs_up", "note": "doble clic en una salida: sube sin andar hasta la escalera (la API falla si el personaje se mueve)", "expect": { "scene": "upstairs", "noListenerGrowth": true } }
      ]
    }
  ]
}
